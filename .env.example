# Required local setup: copy this file to .env before running Docker Compose.
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=ecoyantra-space
JWT_AUDIENCE=ecoyantra-api
ACCESS_TOKEN_TTL=15m
REFRESH_SESSION_TTL_DAYS=30
REFRESH_COOKIE_NAME=ecoyantra_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_DOMAIN=
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY=0
SENTRY_ENABLED=false
SENTRY_DSN=
OTEL_SERVICE_NAME=ecoyantra-api
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
SHUTDOWN_TIMEOUT_MS=210000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=ecoyantra-artifacts
