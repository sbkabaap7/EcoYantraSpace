NODE_ENV=development
HOST=0.0.0.0
PORT=4000
APP_VERSION=0.1.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
SHUTDOWN_TIMEOUT_MS=10000
MONGODB_URI=mongodb://localhost:27017/ecoyantra
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-32-character-minimum-secret
JWT_ISSUER=ecoyantra-space
JWT_AUDIENCE=ecoyantra-api
CARBON_ML_URL=http://localhost:8001
ANOMALY_ML_URL=http://localhost:8002
FOREST_ML_URL=http://localhost:8003
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ecoyantra-artifacts
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
SENTRY_ENABLED=false
# SENTRY_DSN=
