NODE_ENV=development
HOST=0.0.0.0
PORT=4000
APP_VERSION=0.1.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=0
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SHUTDOWN_TIMEOUT_MS=10000
MONGODB_URI=mongodb://localhost:27017/ecoyantra
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=ecoyantra-space
JWT_AUDIENCE=ecoyantra-api
ACCESS_TOKEN_TTL=15m
REFRESH_SESSION_TTL_DAYS=30
REFRESH_COOKIE_NAME=ecoyantra_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
# REFRESH_COOKIE_DOMAIN=
CARBON_ML_URL=http://localhost:8001
ANOMALY_ML_URL=http://localhost:8002
FOREST_ML_URL=http://localhost:8003
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ecoyantra-artifacts
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
SENTRY_ENABLED=false
# SENTRY_DSN=
OTEL_SERVICE_NAME=ecoyantra-api
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
