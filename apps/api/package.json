    "argon2": "^0.45.1",
    "axios": "^1.19.0",
    "bullmq": "^6.1.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
