# Comma-separated frontend addresses permitted to call this API.
# Use * only for a local hackathon demo; use your deployed site URL in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Location of the SQLite database. The Docker setup stores it in /app/data.
ECOSPHERE_DB=data/ecospherai.db

# Keep true for the presentation dashboard. Set false when sending only real readings.
SEED_DEMO_DATA=true
